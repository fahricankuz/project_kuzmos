{
  "root": true,
  "env": {
    "es2021": true,
    "node": true
  },
  "parserOptions": {
    "ecmaVersion": 2021,
    "sourceType": "script"
  },
  "extends": "eslint:recommended",
  "globals": {
    "SpreadsheetApp": "readonly",
    "HtmlService": "readonly",
    "PropertiesService": "readonly",
    "CacheService": "readonly",
    "LockService": "readonly",
    "Utilities": "readonly",
    "Logger": "readonly",
    "ScriptApp": "readonly"
  },
  "overrides": [
    {
      "files": [
        "test/**/*.js"
      ],
      "env": {
        "jest": true,
        "node": true
      }
    },
    {
      "files": [
        "web/js/*.js",
        "tools/demo-api.js",
        "tools/demo-verisi.js"
      ],
      "env": {
        "browser": true,
        "es2021": true,
        "node": false
      },
      "globals": {
        "supabase": "readonly",
        "Chart": "readonly"
      },
      "rules": {
        "no-unused-vars": "off",
        "no-empty": [
          "error",
          {
            "allowEmptyCatch": true
          }
        ]
      }
    }
  ],
  "rules": {
    "no-unused-vars": [
      "warn",
      {
        "args": "none"
      }
    ],
    "no-undef": "off"
  }
}
